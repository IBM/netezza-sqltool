{
  "name": "netezza-sqltools",
  "displayName": "IBM Netezza Developer Extension",
  "description": "SQLTools driver for IBM Netezza databases",
  "version": "0.5.0",
  "engines": {
    "vscode": "^1.78.0"
  },
  "publisher": "abhishek-jog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IBM/netezza-sqltool"
  },
  "bugs": {
    "url": "https://github.com/IBM/netezza-sqltool"
  },
  "keywords": [
    "sqltools-driver",
    "netezza",
    "ibm",
    "nps",
    "database",
    "sql"
  ],
  "galleryBanner": {
    "theme": "dark",
    "color": "#333333"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "extensionDependencies": [
    "mtxr.sqltools"
  ],
  "activationEvents": [
    "*",
    "onLanguage:sql",
    "onCommand:sqltools.*"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "clean": "rimraf -rf out dist *.vsix",
    "predev": "npm run clean",
    "dev": "npm run watch",
    "prebuild": "npm run clean",
    "build": "npm run compile:ext && npm run compile:ls",
    "esbuild": "esbuild --platform=node --tsconfig=./tsconfig.json --external:vscode --external:pg-native --color=true --format=cjs --loader:.node=file",
    "compile:ext": "npm run esbuild -- --bundle ./src/extension.ts --outfile=./out/extension.js --target=es2017 --define:process.env.PRODUCT=\"'ext'\" --define:process.env.NODE_ENV=\"'production'\" --minify",
    "compile:ls": "npm run esbuild -- --bundle ./src/ls/plugin.ts --outfile=./out/ls/plugin.js --target=es2015 --define:process.env.PRODUCT=\"'ls'\" --define:process.env.NODE_ENV=\"'production'\" --minify",
    "watch": "concurrently \"npm:watch:*\"",
    "watch:ext": "npm run esbuild -- --bundle ./src/extension.ts --outfile=./out/extension.js --target=es2017 --define:process.env.PRODUCT='ext' --define:process.env.NODE_ENV='development' --sourcemap --watch",
    "watch:ls": "npm run esbuild -- --bundle ./src/ls/plugin.ts --outfile=./out/ls/plugin.js --target=es2015 --define:process.env.PRODUCT='ls' --define:process.env.NODE_ENV='development' --sourcemap --watch",
    "test": "ts-node test/driver.test.ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@sqltools/base-driver": "^0.2.3",
    "@sqltools/types": "^0.2.0",
    "ibm-netezza": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.78.0",
    "@vscode/vsce": "^2.19.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.25.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  }
}